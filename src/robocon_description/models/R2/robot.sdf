        </inertia>
      </inertial>
      <sensor name="depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>5.0</update_rate>
        <topic>depth_camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.05</near><far>3</far></clip>
        </camera>
      </sensor>
    </link>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/r2/joint_states</topic></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>odom</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>

  </model>
</sdf>