<?xml version="1.0"?>
<sdf version="1.8">
    <model name="R2">
        <self_collide>true</self_collide>
        <link name="base_link">
            <inertial>
                <pose>0.125  0.456 0.004 0 0 0</pose>
                <mass>10.157</mass> <inertia>
                    <ixx>0.399</ixx>   <ixy>-0.014</ixy>  <ixz>-0.003</ixz>   
                    <iyy>0.168</iyy>
                    <iyz>-0.064</iyz>   
                    <izz>0.392</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh><uri>package://robocon_description/models/R2/meshes/R2-NO-A.dae</uri></mesh>
                </geometry>
            </collision>
            <visual name="visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh><uri>package://robocon_description/models/R2/meshes/R2-NO-A.dae</uri></mesh>
                </geometry>
            </visual>
        </link>

        <link name="A_link">
            <inertial>
                <pose>0.125  0.456 0.004 0 0 0</pose>
                <mass>1.502</mass> <inertia>
                    <ixx>0.016</ixx> <ixy>-1.248e-8</ixy> <ixz>1.398e-7</ixz>   
                    <iyy>0.017</iyy> <iyz>-1.527e-4</iyz>   
                    <izz>0.025</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                 <!-- Center X shifted to ~0.12 to be between wheels. Width reduced to 5cm -->
                <pose>0.12 0.45 0 0 0 0</pose>
                <geometry>
                   <box>
                        <size>0.05 0.4 0.2</size>
                    </box>
                </geometry>
            </collision>
            <visual name="visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh><uri>package://robocon_description/models/R2/meshes/R2-A.dae</uri></mesh>
                </geometry>
            </visual>
        </link>

        <joint name="A_joint" type="revolute">
            <parent>base_link</parent>
            <child>A_link</child>
            
            <pose>0.243 0.445 0.04 0 0 0</pose> 

            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                    <lower>-1.57</lower>
                    <upper>1.57</upper>
                </limit>
            </axis>
        </joint>
        
        <!-- <include>
            <uri>model://R2_wheel</uri>
            <name>mid_left_wheel</name>
            <pose>0.04 0.300 -0.184 0 0 0</pose>
        </include> -->
        <link name = "mid_left_wheel"> <pose relative_to="base_link">0.04 0.300 -0.184 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.005</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.005</iyy> <iyz>0</iyz>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="visual">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>  <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>    
        </link>

        <joint name="mid_left_wheel_joint" type="revolute">
            <parent>A_link</parent>
            <child>mid_left_wheel</child> 
            <axis>
                <xyz>1 0 0</xyz> <limit>
                <lower>-1e16</lower>
                <upper>1e16</upper>
                </limit>
            </axis>
        </joint>

        <!-- <include>
            <uri>model://R2_wheel</uri>
            <name>mid_right_wheel</name>
            <pose>0.2 0.300 -0.184 0 0 0</pose>
        </include> -->
        <link name = "mid_right_wheel"> <pose relative_to="base_link">0.2 0.300 -0.184 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.005</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.005</iyy> <iyz>0</iyz>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="visual">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>  <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>    
        </link>

        <joint name="mid_right_wheel_joint" type="revolute">
            <parent>A_link</parent>
            <child>mid_right_wheel</child> 
            <axis>
                <xyz>1 0 0</xyz> <limit>
                <lower>-1e16</lower>
                <upper>1e16</upper>
                </limit>
            </axis>
        </joint>

        <!-- <include>
            <uri>model://R2_wheel</uri>
            <name>front_left_wheel</name>
            <pose>0.04 0.610 -0.184 0 0 0</pose>
        </include> -->
        <link name = "front_left_wheel"> <pose relative_to="base_link">0.04 0.610 -0.184 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.005</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.005</iyy> <iyz>0</iyz>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="visual">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>  <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>    
        </link>

        <joint name="front_left_wheel_joint" type="revolute">
            <parent>A_link</parent>
            <child>front_left_wheel</child> 
            <axis>
                <xyz>1 0 0</xyz> <limit>
                <lower>-1e16</lower>
                <upper>1e16</upper>
                </limit>
            </axis>
        </joint>
        <!-- <include>
        <uri>model://R2_wheel</uri>
        <name>front_right_wheel</name>
        <pose>0.2 0.610 -0.184 0 0 0</pose>
        </include> -->
        <link name = "front_right_wheel"> <pose relative_to="base_link">0.2 0.610 -0.184 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.005</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.005</iyy> <iyz>0</iyz>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="visual">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>  <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>    
        </link>

        <joint name="front_right_wheel_joint" type="revolute">
            <parent>A_link</parent>
            <child>front_right_wheel</child> 
            <axis>
                <xyz>1 0 0</xyz> <limit>
                <lower>-1e16</lower>
                <upper>1e16</upper>
                </limit>
            </axis>
        </joint>

        <!-- <include>
            <uri>model://R2_wheel</uri>
            <name>back_left_wheel</name>
            <pose>0.04 -0.045 -0.180 0 0 0</pose>
        </include> -->
        <link name = "back_left_wheel"> <pose relative_to="base_link">0.04 -0.045 -0.180 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.005</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.005</iyy> <iyz>0</iyz>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="visual">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>  <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>    
        </link>

        <joint name="back_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>back_left_wheel</child> 
            <axis>
                <xyz>1 0 0</xyz> <limit>
                <lower>-1e16</lower>
                <upper>1e16</upper>
                </limit>
            </axis>
        </joint>

        <!-- <include>
            <uri>model://R2_wheel</uri>
            <name>back_right_wheel</name>
            <pose>0.2 -0.045 -0.180 0 0 0</pose>
        </include> -->
        <link name = "back_right_wheel"> <pose relative_to="base_link">0.2 -0.045 -0.180 0 0 0</pose>
            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.005</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.005</iyy> <iyz>0</iyz>
                    <izz>0.005</izz>
                </inertia>
            </inertial>
            <visual name="visual">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision">
            <pose>0 0 0 0 3.1415926535 0</pose>
                <geometry><mesh><uri>package://robocon_description/models/R2_wheel/meshes/wheel.dae</uri></mesh></geometry>
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>  <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>    
        </link>

        <joint name="back_right_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>back_right_wheel</child> 
            <axis>
                <xyz>1 0 0</xyz> <limit>
                <lower>-1e16</lower>
                <upper>1e16</upper>
                </limit>
            </axis>
        </joint>

        <!-- IMU -->
       <joint name='imu_joint' type='fixed'>
            <parent>base_link</parent>
            <child>imu_link</child>
            <pose relative_to="base_link">0.13 0.27 0.125 0 0 0</pose>
        </joint>

        <link name='imu_link'>
            <pose relative_to="imu_joint"/>
            <visual name="imu_link_visual">
                <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
            </visual>
            <collision name="imu_link_collision">
                <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
            </collision>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>0.000167</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.000167</iyy> <iyz>0</iyz>
                    <izz>0.000167</izz>
                </inertia>
            </inertial>
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>100</update_rate>
                <visualize>true</visualize>
                <topic>imu</topic>
                <gz_frame_id>/imu_link</gz_frame_id>
                <imu>
                    <angular_velocity>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </link>
        <!-- Lidar -->
        <joint name="lidar_joint" type="fixed">
            <parent>base_link</parent>
            <child>lidar_link</child>
            <pose relative_to="base_link">0.13 0.27 0.009 0 0 0</pose>
        </joint>

        <link name='lidar_link'>
            <pose relative_to="lidar_joint"/>
            <visual name="lidar_link_visual">
                <geometry>
                    <cylinder><radius>0.0508</radius><length>0.055</length></cylinder>
                </geometry>
            </visual>
            <collision name="lidar_link_collision">
                <geometry>
                    <cylinder><radius>0.0508</radius><length>0.055</length></cylinder>
                </geometry>
            </collision>
            <inertial>
                <mass>0.125</mass>
                <inertia>
                    <ixx>0.000112</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.000112</iyy> <iyz>0</iyz>
                    <izz>0.000161</izz>
                </inertia>
            </inertial>
            <sensor name="lidar" type="gpu_lidar">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>5</update_rate>
                <topic>scan</topic>
                <gz_frame_id>/lidar_link</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples><resolution>1.000000</resolution>
                            <min_angle>0.000000</min_angle><max_angle>6.280000</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.120000</min><max>3.5</max><resolution>0.015000</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </link>

        <!-- Camera -->
        <joint name="camera_joint" type="fixed">
            <parent>base_link</parent>
            <child>camera_link</child>
            <pose relative_to="base_link">0.0 -0.085 -0.12 0 0 0</pose>
        </joint>

        <link name='camera_link'>
            <pose relative_to="camera_joint"/>
            <visual name="camera_link_visual">
                <pose>0.12 0 0.18 0 0 1.570796327</pose>
                <geometry>
                    <box><size>0.015 0.130 0.0222</size></box>
                </geometry>
            </visual>
            <collision name="camera_link_collision">
                <geometry>
                    <box><size>0.015 0.130 0.0222</size></box>
                </geometry>
            </collision>
            <inertial>
                <mass>0.035</mass>
                <inertia>
                    <ixx>0.000050</ixx> <ixy>0</ixy> <ixz>0</ixz>
                    <iyy>0.000002</iyy> <iyz>0</iyz>
                    <izz>0.000050</izz>
                </inertia>
            </inertial>
            <sensor name="depth_camera" type="rgbd_camera">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>5.0</update_rate>
                <topic>depth_camera</topic>
                <gz_frame_id>/camera_link</gz_frame_id>
                <camera>
                    <horizontal_fov>1.047198</horizontal_fov>
                    <image><width>640</width><height>480</height></image>
                    <clip><near>0.05</near><far>3</far></clip>
                </camera>
            </sensor>
        </link>

        <!-- Plugins -->
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>    
        </plugin>
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>/odom</odom_frame>             <robot_base_frame>/base_link</robot_base_frame> <odom_topic>/odometry</odom_topic>
            <!-- <tf_topic>/tf</tf_topic>  removed bcz confilct with ekf bcz In ekf.yaml: You set publish_tf: true-->
            <dimensions>3</dimensions>
        </plugin>
                
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>front_left_wheel_joint</joint_name>
            <sub_topic>joint/front_left_wheel_joint/cmd_vel</sub_topic>
            <p_gain>1.0</p_gain>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>front_right_wheel_joint</joint_name>
            <sub_topic>joint/front_right_wheel_joint/cmd_vel</sub_topic>
            <p_gain>1.0</p_gain>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>mid_left_wheel_joint</joint_name>
            <sub_topic>joint/mid_left_wheel_joint/cmd_vel</sub_topic>
            <p_gain>1.0</p_gain>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>mid_right_wheel_joint</joint_name>
            <sub_topic>joint/mid_right_wheel_joint/cmd_vel</sub_topic>
            <p_gain>1.0</p_gain>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>back_left_wheel_joint</joint_name>
            <sub_topic>joint/back_left_wheel_joint/cmd_vel</sub_topic>
            <p_gain>1.0</p_gain>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
            <joint_name>back_right_wheel_joint</joint_name>
            <sub_topic>joint/back_right_wheel_joint/cmd_vel</sub_topic>
            <p_gain>1.0</p_gain>
        </plugin>

    </model>
</sdf>