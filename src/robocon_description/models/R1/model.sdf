<?xml version="1.0"?>
<sdf version="1.8">

  <model name="R1">
    <static>false</static>

    <!-- ================= BASE ================= -->
    <link name="base_link">
      <inertial>
        <pose>0.419 -0.448 0.116 0 0 0</pose>
        <mass>183.77</mass>
        <inertia>
          <ixx>15.435</ixx>
          <ixy>-0.647</ixy>
          <ixz>0.276</ixz>
          <iyy>17.277</iyy>
          <iyz>1.909</iyz>
          <izz>21.853</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://R1/meshes/R1.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://R1/meshes/R1.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ================= WHEELS ================= -->

    <!-- BACK LEFT -->
    <link name="back_left_wheel">
      <pose>0.82 0 -0.075 1.5707 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.2</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>


    <joint name="back_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>back_left_wheel</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
      <physics>
        <ode>
          <max_force>200</max_force>
        </ode>
      </physics>
    </joint>

    <!-- FRONT LEFT -->
    <link name="front_left_wheel">
      <pose>0.82 -0.700 -0.075 1.5707 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.2</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
      <physics>
        <ode>
          <max_force>200</max_force>
        </ode>
      </physics>
    </joint>

    <!-- BACK RIGHT -->
    <link name="back_right_wheel">
      <pose>-0.01 0 -0.075 1.5707 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.2</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="back_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>back_right_wheel</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
      <physics>
        <ode>
          <max_force>200</max_force>
        </ode>
      </physics>
    </joint>

    <!-- FRONT RIGHT -->
    <link name="front_right_wheel">
      <pose>-0.01 -0.700 -0.075 1.5707 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.2</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://R1/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
      <physics>
        <ode>
          <max_force>200</max_force>
        </ode>
      </physics>
    </joint>

    <!-- Individual Wheel Velocity Controllers -->
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>front_left_wheel_joint</joint_name>
      <sub_topic>joint/front_left_wheel_joint/cmd_vel</sub_topic>
      <p_gain>1.0</p_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>front_right_wheel_joint</joint_name>
      <sub_topic>joint/front_right_wheel_joint/cmd_vel</sub_topic>
      <p_gain>1.0</p_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>back_left_wheel_joint</joint_name>
      <sub_topic>joint/back_left_wheel_joint/cmd_vel</sub_topic>
      <p_gain>1.0</p_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>back_right_wheel_joint</joint_name>
      <sub_topic>joint/back_right_wheel_joint/cmd_vel</sub_topic>
      <p_gain>1.0</p_gain>
    </plugin>

  </model>
</sdf>
